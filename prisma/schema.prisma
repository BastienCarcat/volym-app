// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserType {
  Coach
  Athlete
}

enum Gender {
  Male
  Female
}

enum SetType {
  WarmUp
  Normal
  DropsSet
  Failure
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum ProgramType {
  Days
  Cycle
}

enum CircuitType {
  Superset
  Biset
  Triset
  GiantSet
  AMRAP
}

enum SessionItemType {
  Exercise
  Circuit
}

enum CircuitItemType {
  Exercise
}

enum UserLevel {
  Beginner // < 1 an
  Intermediate // 1-3 ans
  Advanced // 3-5 ans
  Elite // 5+ ans
}

enum ProgramObjective {
  Hypertrophy // Prise de masse musculaire
  Strength // Force maximale
  PowerLifting // Compétition powerlifting
  Endurance // Endurance musculaire
  Recomposition // Perte de gras + muscle
  Athletic // Performance athlétique
  General // Condition physique générale
}

enum BodyPart {
  Legs
  Back
  Chest
  Shoulders
  Arms
  Core
}

// ==========================================
// AUTHENTICATION & USER (Better Auth + Application)
// ==========================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // Application-specific fields
  firstname  String     @default("")
  lastname   String     @default("")
  gender     Gender     @default(Male)
  weight     Int?
  height     Int?
  type       UserType   @default(Athlete)
  level      UserLevel?
  weaknesses BodyPart[]
  strengths  BodyPart[]

  // Relations
  programs         Program[]
  workoutTemplates WorkoutTemplate[]
  sessions         AuthSession[]
  accounts         Account[]

  @@unique([email])
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

// ==========================================
// PROGRAMS & SESSIONS
// ==========================================

model Program {
  id        String            @id @default(uuid())
  createdBy String
  note      String?           @db.Text
  name      String
  type      ProgramType       @default(Days)
  objective ProgramObjective?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [createdBy], references: [id])
  sessions Session[]

  @@index([createdBy])
  @@index([deletedAt])
}

model Session {
  id         String     @id @default(uuid())
  programId  String
  templateId String?
  name       String
  note       String?    @db.Text
  day        DayOfWeek?
  cycleDay   Int?
  isRestDay  Boolean    @default(false)
  weekNumber Int? // Required for Days type, null for Cycle type
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  program      Program          @relation(fields: [programId], references: [id])
  template     WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sessionItems SessionItem[]

  @@index([programId])
  @@index([templateId])
  @@index([deletedAt])
}

// ==========================================
// WORKOUT TEMPLATES (Library)
// ==========================================

model WorkoutTemplate {
  id        String    @id @default(uuid())
  createdBy String
  name      String
  note      String?   @db.Text
  isPublic  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User           @relation(fields: [createdBy], references: [id])
  sessions      Session[]
  templateItems TemplateItem[]

  @@index([createdBy])
  @@index([isPublic])
  @@index([deletedAt])
}

// ==========================================
// SESSION & TEMPLATE ITEMS (Polymorphic)
// ==========================================

model SessionItem {
  id         String          @id @default(uuid())
  type       SessionItemType
  order      Int
  sessionId  String
  exerciseId String?         @unique
  circuitId  String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  session  Session   @relation(fields: [sessionId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])
  circuit  Circuit?  @relation(fields: [circuitId], references: [id])

  @@index([sessionId, order])
  @@index([exerciseId])
  @@index([circuitId])
  @@index([deletedAt])
}

model TemplateItem {
  id         String          @id @default(uuid())
  type       SessionItemType
  order      Int
  templateId String
  exerciseId String?         @unique
  circuitId  String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  template WorkoutTemplate @relation(fields: [templateId], references: [id])
  exercise Exercise?       @relation(fields: [exerciseId], references: [id])
  circuit  Circuit?        @relation(fields: [circuitId], references: [id])

  @@index([templateId, order])
  @@index([exerciseId])
  @@index([circuitId])
  @@index([deletedAt])
}

// ==========================================
// CIRCUITS (Intensity Techniques)
// ==========================================

model Circuit {
  id        String      @id @default(uuid())
  type      CircuitType
  duration  Int?
  rest      Int?
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  circuitItems  CircuitItem[]
  sessionItems  SessionItem[]
  templateItems TemplateItem[]

  @@index([deletedAt])
}

model CircuitItem {
  id         String          @id @default(uuid())
  type       CircuitItemType
  order      Int
  circuitId  String
  exerciseId String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  circuit  Circuit   @relation(fields: [circuitId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])

  @@index([circuitId, order])
  @@index([exerciseId])
  @@index([deletedAt])
}

// ==========================================
// EXERCISES & SETS (Unified)
// ==========================================

model Exercise {
  id         String    @id @default(uuid())
  exerciseId String // GymFit ID
  note       String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sets Set[]

  // Backrefs (exactly 1 must exist)
  sessionItem  SessionItem?
  templateItem TemplateItem?
  circuitItem  CircuitItem?

  @@index([deletedAt])
}

model Set {
  id         String    @id @default(uuid())
  exerciseId String
  weight     Int?
  reps       Int?
  rest       Int?
  order      Int
  type       SetType   @default(Normal)
  rpe        Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([exerciseId, order])
  @@index([deletedAt])
}
