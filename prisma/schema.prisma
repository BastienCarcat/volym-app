// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserType {
  Coach
  Athlete
}

enum Gender {
  Male
  Female
}

enum SetType {
  WarmUp
  Normal
  DropsSet
  Failure
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum ProgramType {
  Days
  Cycle
}

enum CircuitType {
  Superset
  Biset
  Triset
  GiantSet
  AMRAP
}

enum SessionItemType {
  Exercise
  Circuit
}

enum CircuitItemType {
  Exercise
}

// ==========================================
// USERS
// ==========================================

model User {
  id        String   @id @default(uuid())
  weight    Int?
  height    Int?
  lastname  String
  firstname String
  gender    Gender
  email     String   @unique
  type      UserType @default(Athlete)

  programs         Program[]
  workoutTemplates WorkoutTemplate[]
}

// ==========================================
// PROGRAMS & SESSIONS
// ==========================================

model Program {
  id        String      @id @default(uuid())
  createdBy String
  note      String?     @db.Text
  name      String
  type      ProgramType @default(Days)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [createdBy], references: [id])
  sessions Session[]

  @@index([createdBy])
  @@index([deletedAt])
}

model Session {
  id         String     @id @default(uuid())
  programId  String
  templateId String?
  name       String
  note       String?    @db.Text
  day        DayOfWeek?
  cycleDay   Int?
  isRestDay  Boolean    @default(false)
  weekNumber Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  program      Program          @relation(fields: [programId], references: [id])
  template     WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sessionItems SessionItem[]

  @@index([programId])
  @@index([templateId])
  @@index([deletedAt])
}

// ==========================================
// WORKOUT TEMPLATES (Library)
// ==========================================

model WorkoutTemplate {
  id        String    @id @default(uuid())
  createdBy String
  name      String
  note      String?   @db.Text
  isPublic  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User           @relation(fields: [createdBy], references: [id])
  sessions      Session[]
  templateItems TemplateItem[]

  @@index([createdBy])
  @@index([isPublic])
  @@index([deletedAt])
}

// ==========================================
// SESSION & TEMPLATE ITEMS (Polymorphic)
// ==========================================

model SessionItem {
  id         String          @id @default(uuid())
  type       SessionItemType
  order      Int
  sessionId  String
  exerciseId String?         @unique
  circuitId  String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  session  Session   @relation(fields: [sessionId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])
  circuit  Circuit?  @relation(fields: [circuitId], references: [id])

  @@index([sessionId, order])
  @@index([exerciseId])
  @@index([circuitId])
  @@index([deletedAt])
}

model TemplateItem {
  id         String          @id @default(uuid())
  type       SessionItemType
  order      Int
  templateId String
  exerciseId String?         @unique
  circuitId  String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  template WorkoutTemplate @relation(fields: [templateId], references: [id])
  exercise Exercise?       @relation(fields: [exerciseId], references: [id])
  circuit  Circuit?        @relation(fields: [circuitId], references: [id])

  @@index([templateId, order])
  @@index([exerciseId])
  @@index([circuitId])
  @@index([deletedAt])
}

// ==========================================
// CIRCUITS (Intensity Techniques)
// ==========================================

model Circuit {
  id        String      @id @default(uuid())
  type      CircuitType
  duration  Int?
  rest      Int?
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  circuitItems  CircuitItem[]
  sessionItems  SessionItem[]
  templateItems TemplateItem[]

  @@index([deletedAt])
}

model CircuitItem {
  id         String          @id @default(uuid())
  type       CircuitItemType
  order      Int
  circuitId  String
  exerciseId String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  circuit  Circuit   @relation(fields: [circuitId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])

  @@index([circuitId, order])
  @@index([exerciseId])
  @@index([deletedAt])
}

// ==========================================
// EXERCISES & SETS (Unified)
// ==========================================

model Exercise {
  id         String    @id @default(uuid())
  exerciseId String // GymFit ID
  note       String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sets Set[]

  // Backrefs (exactly 1 must exist)
  sessionItem  SessionItem?
  templateItem TemplateItem?
  circuitItem  CircuitItem?

  @@index([deletedAt])
}

model Set {
  id         String    @id @default(uuid())
  exerciseId String
  weight     Int?
  reps       Int?
  rest       Int?
  order      Int
  type       SetType   @default(Normal)
  rpe        Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([exerciseId, order])
  @@index([deletedAt])
}
